{
  "name": "practice-app",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "acorn": "^8.19.0",
    "ajv": "^8.20.0",
    "cheerio": "^1.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "js-yaml": "^5.5.0",
    "marked": "^18.2.0",
    "preact": "^11.2.0",
    "temml": "^0.14.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --dev && wrangler dev",
    "typecheck": "tsc",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply practice-app-db --local",
    "db:migrate:remote": "node scripts/migrate-remote.mjs",
    "deploy": "node scripts/build.mjs && wrangler deploy"
  }
}
