  {
   "id": "q6",
   "number": "6",
   "type": "mcq_single",
   "stem": "An equilateral triangle of side 14 cm has been cut off from a rectangle as shown. The perimeter of the resulting figure is \\_\\_\\_\\_\\_\\_\\_ than that of the original rectangle.\n\n![figure](asset:q6-stem-fig)",
   "options": [
    {
     "label": "A",
     "text": "14 cm less"
    },
    {
     "label": "B",
     "text": "28 cm less"
    },
    {
     "label": "C",
     "text": "14 cm more"
    },
    {
     "label": "D",
     "text": "28 cm more"
    }
   ],
   "answer": "C",
   "solution": "**(C)** Perimeter of the required figure\n\n14 × 2 – 14\n\n= 28 – 14\n\n= 14 more",
   "topics": [
    "Mathematics"
   ],
   "fields": {
