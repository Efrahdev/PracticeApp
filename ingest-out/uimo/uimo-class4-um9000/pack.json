  {
   "id": "q1",
   "number": "1",
   "type": "mcq_single",
   "stem": "A ladybird has six legs. Altogether, how many legs do sixty-six ladybirds have ?",
   "options": [
    {
     "label": "A",
     "text": "36"
    },
    {
     "label": "B",
     "text": "66"
    },
    {
     "label": "C",
     "text": "396"
    },
    {
     "label": "D",
     "text": "666"
    }
   ],
   "answer": "C",
   "solution": "**(C)** No. of legs to a ladybird = 6\n\nNo. of legs to 66 ladybirds = ? 66 × 6 = 396 legs",
   "topics": [
    "Mathematics"
   ],
   "fields": {
