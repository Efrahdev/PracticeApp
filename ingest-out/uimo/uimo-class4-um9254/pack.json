  {
   "id": "q5",
   "number": "5",
   "type": "mcq_single",
   "stem": "A number is between 47 and 63. It is also a multiple of\n\n8\\. When divided by 9, the remainder is 2. What is the number ?",
   "options": [
    {
     "label": "A",
     "text": "48"
    },
    {
     "label": "B",
     "text": "56"
    },
    {
     "label": "C",
     "text": "40"
    },
    {
     "label": "D",
     "text": "60"
    }
   ],
   "answer": "B",
   "solution": "(B) Multiples of 8 = 8, 16, 24, 32, 40, 48, 56,\n\n63, 80\n\nNumbers between = 47 & 63 = 48 and 56 Divide 48 ÷ 9 = 5 R 3\n\nDivide 56 ÷ 9 = 6 R 2\n\nSo, the number is 56",
   "topics": [
    "Mathematics"
   ],
   "fields": {
    "Exam": "UIMO",
    "Class": 4,
    "Paper": "UIMO UM9254",
    "Paper code": "UM9254",
    "Section": "Mathematics"
   },
   "source": {
    "file": "UIMO_CLASS-4_Past-8-Papers.pdf",
    "page": 105
   }
  },
