  {
   "id": "q7",
   "number": "7",
   "type": "mcq_single",
   "stem": "Ashwin bought 6 packets of sweets. Each packet contained 495 sweets. He gave 60 sweets to his sister and divided the remaining sweets equally among 5 friends. How many sweets did each friend get ?",
   "options": [
    {
     "label": "A",
     "text": "582"
    },
    {
     "label": "B",
     "text": "495"
    },
    {
     "label": "C",
     "text": "2910"
    },
    {
     "label": "D",
     "text": "2970"
    }
   ],
   "answer": "A",
   "solution": "![A Number of sweet packets = 6 Number of sweets in 1 packet = 495 Number of sweets in 6 packets = 495 × 6 = 2970 Number of sweets given to his sister = 60 Number of remaining sweets = 2970 – 60 = 2910 2910 ÷ 5 = 582 Each friend will get 582 sweets](asset:q7-sol)",
   "topics": [
    "Mathematics"
   ],
   "fields": {
    "Exam": "UIMO",
    "Class": 4,
    "Paper": "UIMO UM9254",
    "Paper code": "UM9254",
