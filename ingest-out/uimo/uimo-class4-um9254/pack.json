  {
   "id": "q4",
   "number": "4",
   "type": "mcq_single",
   "stem": "Choose the difference between the ninth multiple of 8 and the second multiple of 9.",
   "options": [
    {
     "label": "A",
     "text": "90"
    },
    {
     "label": "B",
     "text": "54"
    },
    {
     "label": "C",
     "text": "72"
    },
    {
     "label": "D",
     "text": "82"
    }
   ],
   "answer": "B",
   "solution": "![B Ninth multiple of 8 = 8 × 9 = 72 Second multiple of 9 = 9 × 2 = 18 difference = 72 – 18 = 54](asset:q4-sol)",
   "topics": [
    "Mathematics"
   ],
   "fields": {
