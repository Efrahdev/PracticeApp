  {
   "id": "q3",
   "number": "3",
   "type": "mcq_single",
   "stem": "A blue ribbon is 125 cm long. A red ribbon is 380 cm longer than the blue ribbon but 98 cm shorter than a pink ribbon. What is the length of the pink ribbon ?",
   "options": [
    {
     "label": "A",
     "text": "600 cm"
    },
    {
     "label": "B",
     "text": "601 cm"
    },
    {
     "label": "C",
     "text": "602 cm"
    },
    {
     "label": "D",
     "text": "603 cm"
    }
   ],
   "answer": "D",
   "solution": "(D) Length of a blue ribbon = 125 cm\n\nLength of red ribbon = 125 cm + 380 cm = 505 cm\n\nLength of the pink ribbon = 505 cm + 98 cm = 603 cm",
   "topics": [
    "Mathematics"
   ],
   "fields": {
