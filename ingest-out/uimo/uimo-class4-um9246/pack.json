   "id": "q43",
   "number": "43",
   "type": "mcq_single",
   "stem": "Each of B, C and D are shorter than A. Also C is taller than B but shorter than D, then who among these 4 is the shortest ?",
   "options": [
    {
     "label": "A",
     "text": "A"
    },
    {
     "label": "B",
     "text": "B"
    },
    {
     "label": "C",
     "text": "C"
    },
    {
     "label": "D",
     "text": "D"
    }
   ],
   "answer": "B",
   "solution": "If C is taller than B, then we get C \\> B and C is shorter than D, then we get D \\> C. Thus we get the relation D \\> C \\> B. Now, as all of B, C and D are shorter than A. This means A is the tallest person here. Thus, A \\> D \\> C \\> B.",
   "topics": [
    "Reasoning"
   ],
   "fields": {
    "Exam": "UIMO",
    "Class": 4,
    "Paper": "UIMO UM9246",
    "Paper code": "UM9246",
    "Section": "Reasoning"
   },
   "source": {
