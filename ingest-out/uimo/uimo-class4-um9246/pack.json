   "number": "1",
   "type": "mcq_single",
   "stem": "The difference between 3446 and the product of 6 and 1256 is \\_\\_\\_\\_\\_\\_\\_\\_.",
   "options": [
    {
     "label": "A",
     "text": "4090"
    },
    {
     "label": "B",
     "text": "10 982"
    },
    {
     "label": "C",
     "text": "19 420"
    },
    {
     "label": "D",
     "text": "21 932"
    }
   ],
   "answer": "A",
   "solution": "(A) 1256 × 6 = 7536\n\n7536 – 3446 = 4090",
