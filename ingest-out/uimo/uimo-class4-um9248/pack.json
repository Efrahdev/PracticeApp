  {
   "id": "q8",
   "number": "8",
   "type": "mcq_single",
   "stem": "Which of the following rectangles has the largest perimeter ?",
   "options": [
    {
     "label": "A",
     "text": "![Area 2 8 cm = 96 cm](asset:q8-optA)"
    },
    {
     "label": "B",
     "text": "![Area = 90 cm 2 15 cm](asset:q8-optB)"
    },
    {
     "label": "C",
     "text": "![Area = 110 cm 2 10 cm](asset:q8-optC)"
    },
    {
     "label": "D",
     "text": "![Area = 100 cm 2 25 cm](asset:q8-optD)"
    }
   ],
   "answer": "D",
   "solution": "Option (A): Length = 96 ÷ 8 = 12 cm Perimeter = 8 + 8 + 12 + 12 = 40 cm Option (B): Length = 90 ÷ 15 = 6 cm Perimeter = 15 + 15 + 6 + 6 = 42 cm Option (C): Length = 110 ÷ 10 = 11 cm Perimeter = 10 + 10 + 11 + 11 = 42 cm Option (D): Length = 100 ÷ 25 = 4 cm Perimeter = 25 + 25 + 4 + 4 = 58 cm",
   "topics": [
    "Mathematics"
   ],
