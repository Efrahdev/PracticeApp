  {
   "id": "q12",
   "number": "12",
   "type": "mcq_single",
   "stem": "Two numbers, A and B, add up to 12. C is 4 more than B. C and B add up to 14. Find the values of A, B and C.",
   "options": [
    {
     "label": "A",
     "text": "A = 5, B = 7, C = 9"
    },
    {
     "label": "B",
     "text": "A = 9, B = 5, C = 7"
    },
    {
     "label": "C",
     "text": "A = 7, B = 5, C = 9"
    },
    {
     "label": "D",
     "text": "A = 5, B = 9, C = 7"
    }
   ],
   "answer": "C",
   "solution": "Given C = B + 4 B + C = 14\n\nB + B + 4 = 14\n\n2B = 10 ⇒ B = 5 C = B + 4\n\nC = 5 + 4 = 9\n\nC = 9\n\nA + B = 12\n\nA + 5 = 12\n\nA = 7",
   "topics": [
    "Mathematics"
   ],
   "fields": {
    "Exam": "UIMO",
    "Class": 4,
    "Paper": "UIMO UM9248",
    "Paper code": "UM9248",
