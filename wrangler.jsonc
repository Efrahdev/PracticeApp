{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "practice-app",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "practice-app-db",
      "database_id": "7a9fd7db-5fff-4008-a7c2-f913507b3cda",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "practice-app-files" }
  ],
  "vars": {
    // Filled in after Cloudflare Access is switched on (see README). Until both are set,
    // the deployed app refuses every request (fails closed).
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "observability": { "enabled": true }
}
